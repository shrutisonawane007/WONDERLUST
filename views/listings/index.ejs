<% layout("/layouts/boilerplate") %>
  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .filter {
      text-align: center;
      margin-right: 2.5rem;
      margin-top: 2rem;
      opacity: 0.7;
      transition: 0.2s all ease;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .filter p {
      font-size: 0.8rem;
    }

    .tax-info {
      display: none;
      font-size: 0.8rem;
      color: rgb(69, 68, 68);
    }

    .tax-toggle {
      border: solid 1px rgb(102, 102, 102);
      border-radius: 1rem;
      height: 3.15rem;
      padding: 1rem;
      opacity: 0.9;
      margin-left: 3rem;
      display: flex;
      align-items: center;
    }

    .filter-link {
      text-decoration: none;
      color: inherit;
    }

    .filter-active .filter {
      opacity: 1 !important;
      border-bottom: 2px solid #fe422d;
      padding-bottom: 2px;
    }
  </style>

  <!-- <h3>ALL LISTINGS</h3> -->
  <div id="filters">
    <a href="<%= selectedCategory === 'Trending' ? '/listings' : '/listings?category=Trending' %>"
      class="filter-link <%= selectedCategory === 'Trending' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Rooms' ? '/listings' : '/listings?category=Rooms' %>"
      class="filter-link <%= selectedCategory === 'Rooms' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Iconic cities' ? '/listings' : '/listings?category=Iconic cities' %>"
      class="filter-link <%= selectedCategory === 'Iconic cities' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic cities</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Mountains' ? '/listings' : '/listings?category=Mountains' %>"
      class="filter-link <%= selectedCategory === 'Mountains' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Castles' ? '/listings' : '/listings?category=Castles' %>"
      class="filter-link <%= selectedCategory === 'Castles' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Amezing pools' ? '/listings' : '/listings?category=Amezing pools' %>"
      class="filter-link <%= selectedCategory === 'Amezing pools' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amezing pools</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Camping' ? '/listings' : '/listings?category=Camping' %>"
      class="filter-link <%= selectedCategory === 'Camping' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Farms' ? '/listings' : '/listings?category=Farms' %>"
      class="filter-link <%= selectedCategory === 'Farms' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Arctic' ? '/listings' : '/listings?category=Arctic' %>"
      class="filter-link <%= selectedCategory === 'Arctic' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Domes' ? '/listings' : '/listings?category=Domes' %>"
      class="filter-link <%= selectedCategory === 'Domes' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
      </div>
    </a>
    <a href="<%= selectedCategory === 'Boats' ? '/listings' : '/listings?category=Boats' %>"
      class="filter-link <%= selectedCategory === 'Boats' ? 'filter-active' : '' %>">
      <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
      </div>
    </a>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
        <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
      </div>
    </div>
  </div>

  <% if (allListings.length===0) { %>
    <div class="col-12 text-center mt-5 mb-5">
      <div class="alert alert-secondary py-5 bg-light border-0 rounded-4 shadow-sm">
        <i class="fa-regular fa-face-frown fa-3x mb-3" style="color: #fe422d;"></i>
        <h4 class="fw-bold">No Destinations Found</h4>
        <p class="text-muted">We couldn't find any listings matching your request. Try browsing other categories or
          explore all listings!</p>
        <a href="/listings" class="btn btn-dark mt-2 px-4 rounded-pill shadow-sm">Reset Filters & Search</a>
      </div>
    </div>
    <% } else { %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings){ %>
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
              <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_img" style="height: 20rem;">
              <div class="card-img-overlay"></div>
              <div class="card-body">
                <p class="card-text">
                  <b>
                    <%= listing.title %>
                  </b><br>
                  &#8377;<%= listing.price %>/night
                    <i class="tax-info"> &nbsp; +18% GST</i>
                </p>
              </div>
            </div>
          </a>
          <% } %>
      </div>
      <% } %>
        <script>
          let taxSwitch = document.getElementById("flexSwitchCheckDefault")
          taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (info of taxInfo) {
              if (info.style.display != "inline") {
                info.style.display = "inline";
              } else {
                info.style.display = "none";
              }
            }
          });
        </script>